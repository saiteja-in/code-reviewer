# =============================================================================
# AI Code Review — environment template
# Copy to .env and fill in values:  cp .env.example .env
# =============================================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (better-auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- GitHub OAuth (dashboard login + repo connect) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (bot reviews, indexing — Steps 6+) ---
# See scripts/setup/github-app-setup.md for full registration guide.
GITHUB_APP_ID=
# PEM private key on one line; use scripts/setup/encode-pem-for-env.ps1
GITHUB_APP_PRIVATE_KEY=
# Must match the secret configured on the GitHub App webhook settings.
GITHUB_WEBHOOK_SECRET=
# Optional: GitHub Enterprise Server API root (Step 7+)
# GITHUB_API_BASE_URL=https://your-ghes-host/api/v3

# Optional: targets for pnpm verify:github-app-api
# GITHUB_APP_TEST_INSTALLATION_ID=
# GITHUB_APP_TEST_OWNER=
# GITHUB_APP_TEST_REPO=

# --- Database (local Docker from Step 1) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codereviewer

# --- Neo4j (code graph — Step 4+) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# --- LLM ---
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-4-6
# diff = baseline only | graph = codebase-aware (after Step 19)
REVIEW_MODE=diff

# --- Embeddings (Step 19+ optional hybrid retrieval) ---
VOYAGE_API_KEY=
EMBED_MODEL=voyage-code-3
EMBED_DIM=1024

# --- Email OTP (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Inngest ---
# Local dev: use dev server (required or /api/inngest returns 500)
INNGEST_DEV=1
# Production: set signing + event keys instead of INNGEST_DEV
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# --- Indexer worker (Inngest Connect — Step 12+) ---
# Same keys as above when running workers/indexer locally
# INDEXER_WORKSPACE_DIR=/tmp/repos
